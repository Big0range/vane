PORT=9999
# mysql 配置
MYSQL_DATABASE = 'vane'
# 这将检查数据库中表的当前状态(它具有哪些列,它们的数据类型等),然后在表中进行必要的更改以使其与模型匹配. 正式环境 请设置为 'false'
MYSQL_ALERT = 'false'
# 支持多个数据库 以空格分隔 请确保个数一致 第一个为主库 其余为从库
MYSQL_HOST =     'vane-mysql-master vane-mysql-node1 vane-mysql-node2'
MYSQL_PORT =     '3307              3308             3309'
MYSQL_USER =     'root              root             root'
# 请及时更改为自己的密码
MYSQL_PASSWORD = '******            ******           ******'

# redis 配置
REDIS_DB = '1'
REDIS_PORT = '6380'
REDIS_HOST = 'vane-redis-master'
# 请及时更改为自己的密码
REDIS_PASSWORD = '******'

# TODO 未完成主从数据库配置

# session 配置
SESSION_SECRET = '*******'
# session 过期时间 60s
SESSION_EXPIRE = 60000

# MD5加密盐
MD5_SALT='******'


# 请替换自己公钥私钥  在线生成地址===>https://uutool.cn/rsa-generate/
# token 加密私钥
PRIVATE_KEY = '-----BEGIN RSA PRIVATE KEY-----
*****
-----END RSA PRIVATE KEY-----'

# token 解密公钥
PUBLIC_KEY = '-----BEGIN RSA PUBLIC KEY-----
*****
-----END RSA PUBLIC KEY-----'
# token type
TOKEN_TYPE = 'Bearer'

# 腾讯对象存储
COS_SECRET_ID = '***'
COS_SECRET_KEY = '***'
COS_REGION = 'ap-***'
COS_BUCKET = '***'
