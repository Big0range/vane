{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "strict": true,

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "isolatedModules": true,
    "noEmit": true,

    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "index.ts"]
}
